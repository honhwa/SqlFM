<Window x:Class="SqlFM.Options.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SqlFM.Options"
        xmlns:loc="clr-namespace:SqlFM.Localization"
        xmlns:cfg="clr-namespace:SqlFM.Core.Configuration;assembly=SqlFM.Core"
        Title="{loc:Tr Key=WindowTitle}"
        Width="900" Height="700"
        MinWidth="700" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False">

    <Window.Resources>
        <!-- 标签宽度 -->
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Width" Value="200"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style x:Key="RowPanel" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        <!-- CheckBox 行 -->
        <Style x:Key="CheckRow" TargetType="CheckBox">
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- 分组小标题 -->
        <Style x:Key="SubHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,10,0,6"/>
        </Style>
        <!-- 枚举下拉本地化显示名转换器 -->
        <loc:EnumLocalizedConverter x:Key="EnumLocalizer"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- 工具栏：样式管理 + 语言 + 导入/导出 -->
            <RowDefinition Height="*"/>     <!-- 主内容：核心开关 + 高级折叠 -->
            <RowDefinition Height="180"/>   <!-- SQL 预览 -->
            <RowDefinition Height="Auto"/>  <!-- 底部按钮 -->
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- 行1：工具栏 -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="#F5F5F5" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="8,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 样式选择区 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="{loc:Tr Key=StyleLabel}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <ComboBox Width="160" Margin="0,0,6,0"
                              ItemsSource="{Binding StyleNames}"
                              SelectedItem="{Binding SelectedStyleName, Mode=TwoWay}"/>
                    <Button Content="{loc:Tr Key=BtnNew}" Width="48" Margin="0,0,3,0" Command="{Binding NewStyleCommand}"/>
                    <Button Content="{loc:Tr Key=BtnCopy}" Width="48" Margin="0,0,3,0" Command="{Binding CopyStyleCommand}"/>
                    <Button Content="{loc:Tr Key=BtnRename}" Width="56" Margin="0,0,3,0" Command="{Binding RenameStyleCommand}"/>
                    <Button Content="{loc:Tr Key=BtnDelete}" Width="48" Margin="0,0,3,0" Command="{Binding DeleteStyleCommand}"/>
                    <Button Content="{loc:Tr Key=BtnSetDefault}" Width="64" Command="{Binding SetDefaultCommand}"/>
                </StackPanel>

                <!-- 语言 + 导入/导出 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="{loc:Tr Key=LangLabel}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <ComboBox x:Name="LanguageCombo" Width="100" Margin="0,0,10,0"
                              SelectionChanged="LanguageCombo_SelectionChanged">
                        <ComboBoxItem Content="{loc:Tr Key=LangZh}" Tag="ZhCn"/>
                        <ComboBoxItem Content="{loc:Tr Key=LangEn}" Tag="En"/>
                        <ComboBoxItem Content="{loc:Tr Key=LangAuto}" Tag="Auto"/>
                    </ComboBox>
                    <Button Content="{loc:Tr Key=BtnImport}" Width="48" Margin="0,0,3,0" Command="{Binding ImportCommand}"/>
                    <Button Content="{loc:Tr Key=BtnExport}" Width="48" Command="{Binding ExportCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- 行2：核心开关（常驻） + 高级选项（折叠） -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <ScrollViewer Grid.Row="1" Margin="4,4,4,0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="12,8">

                <!-- ─── 核心常用设置（常驻，覆盖 90% 场景） ─── -->
                <TextBlock Text="{loc:Tr Key=GrpCore}" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
                <Border BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="4" Padding="10,4" Background="#FAFAFA">
                    <StackPanel>
                        <StackPanel Style="{StaticResource RowPanel}">
                            <TextBlock Text="{loc:Tr Key=LblIndentSize}" Style="{StaticResource LabelStyle}"/>
                            <TextBox Width="60" Text="{Binding Global.IndentSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     TextChanged="Setting_Changed"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource RowPanel}">
                            <TextBlock Text="{loc:Tr Key=LblMaxLineWidth}" Style="{StaticResource LabelStyle}"/>
                            <TextBox Width="60" Text="{Binding Global.MaxLineWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     TextChanged="Setting_Changed"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource RowPanel}">
                            <TextBlock Text="{loc:Tr Key=LblSqlKeyword}" Style="{StaticResource LabelStyle}"/>
                            <ComboBox Width="120" ItemsSource="{Binding KeywordCases}"
                                      SelectedItem="{Binding Global.KeywordCase, Mode=TwoWay}"
                                      SelectionChanged="Setting_Changed">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumLocalizer}}"/></DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Style="{StaticResource RowPanel}">
                            <TextBlock Text="{loc:Tr Key=LblComma}" Style="{StaticResource LabelStyle}"/>
                            <ComboBox Width="120" ItemsSource="{Binding CommaPositions}"
                                      SelectedItem="{Binding Dml.CommaPosition, Mode=TwoWay}"
                                      SelectionChanged="Setting_Changed">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumLocalizer}}"/></DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Style="{StaticResource RowPanel}">
                            <TextBlock Text="{loc:Tr Key=LblBracket}" Style="{StaticResource LabelStyle}"/>
                            <ComboBox Width="120" ItemsSource="{Binding BracketModes}"
                                      SelectedItem="{Binding Global.SquareBracketMode, Mode=TwoWay}"
                                      SelectionChanged="Setting_Changed">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumLocalizer}}"/></DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <CheckBox Content="{loc:Tr Key=ChkTrimTrailing}" IsChecked="{Binding Global.TrimTrailingSpaces, Mode=TwoWay}"
                                  Style="{StaticResource CheckRow}" Click="Setting_Changed"/>
                        <CheckBox Content="{loc:Tr Key=ChkRemoveBlank}" IsChecked="{Binding Global.RemoveExtraBlankLines, Mode=TwoWay}"
                                  Style="{StaticResource CheckRow}" Click="Setting_Changed"/>
                        <CheckBox Content="{loc:Tr Key=ChkJoinNewLine}" IsChecked="{Binding Dml.JoinKeywordNewLine, Mode=TwoWay}"
                                  Style="{StaticResource CheckRow}" Click="Setting_Changed"/>
                    </StackPanel>
                </Border>

                <!-- ─── 高级选项（默认折叠，收纳其余 60+ 项，不删任何功能） ─── -->
                <Expander Grid.Row="0" Margin="0,14,0,0" IsExpanded="False"
                          Header="{loc:Tr Key=ExpAdvTitle}">
                    <StackPanel Margin="4,8,4,4">

                        <!-- 全局通用（其余项） -->
                        <TextBlock Text="{loc:Tr Key=TabGeneral}" Style="{StaticResource SubHeader}"/>
                        <TextBlock Text="{loc:Tr Key=GrpIndentSpaces}" FontWeight="Bold" Margin="0,0,0,6"/>
                        <StackPanel Style="{StaticResource RowPanel}">
                            <TextBlock Text="{loc:Tr Key=LblIndentType}" Style="{StaticResource LabelStyle}"/>
                            <ComboBox Width="120" ItemsSource="{Binding IndentTypes}"
                                      SelectedItem="{Binding Global.IndentType, Mode=TwoWay}"
                                      SelectionChanged="Setting_Changed">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumLocalizer}}"/></DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <CheckBox Content="{loc:Tr Key=ChkMergeSpaces}" IsChecked="{Binding Global.MergeMultipleSpaces, Mode=TwoWay}"
                                  Style="{StaticResource CheckRow}" Click="Setting_Changed"/>
                        <TextBlock Text="{loc:Tr Key=GrpBlankLines}" FontWeight="Bold" Margin="0,10,0,6"/>
                        <StackPanel Style="{StaticResource RowPanel}">
                            <TextBlock Text="{loc:Tr Key=LblStmtBlank}" Style="{StaticResource LabelStyle}"/>
                            <TextBox Width="60" Text="{Binding Global.StatementBlankLines, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     TextChanged="Setting_Changed"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource RowPanel}">
                            <TextBlock Text="{loc:Tr Key=LblGoBefore}" Style="{StaticResource LabelStyle}"/>
                            <TextBox Width="60" Text="{Binding Global.GoBeforeBlankLines, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     TextChanged="Setting_Changed"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource RowPanel}">
                            <TextBlock Text="{loc:Tr Key=LblGoAfter}" Style="{StaticResource LabelStyle}"/>
                            <TextBox Width="60" Text="{Binding Global.GoAfterBlankLines, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     TextChanged="Setting_Changed"/>
                        </StackPanel>
                        <TextBlock Text="{loc:Tr Key=GrpKeywordCase}" FontWeight="Bold" Margin="0,10,0,6"/>
                        <StackPanel Style="{StaticResource RowPanel}">
                            <TextBlock Text="{loc:Tr Key=LblFunction}" Style="{StaticResource LabelStyle}"/>
                            <ComboBox Width="120" ItemsSource="{Binding KeywordCases}"
                                      SelectedItem="{Binding Global.FunctionCase, Mode=TwoWay}"
                                      SelectionChanged="Setting_Changed">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumLocalizer}}"/></DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Style="{StaticResource RowPanel}">
                            <TextBlock Text="{loc:Tr Key=LblDataType}" Style="{StaticResource LabelStyle}"/>
                            <ComboBox Width="120" ItemsSource="{Binding KeywordCases}"
                                      SelectedItem="{Binding Global.DataTypeCase, Mode=TwoWay}"
                                      SelectionChanged="Setting_Changed">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumLocalizer}}"/></DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Style="{StaticResource RowPanel}">
                            <TextBlock Text="{loc:Tr Key=LblObjectName}" Style="{StaticResource LabelStyle}"/>
                            <ComboBox Width="120" ItemsSource="{Binding ObjectNameCases}"
                                      SelectedItem="{Binding Global.ObjectNameCase, Mode=TwoWay}"
                                      SelectionChanged="Setting_Changed">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumLocalizer}}"/></DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Style="{StaticResource RowPanel}">
                            <TextBlock Text="{loc:Tr Key=LblVarParam}" Style="{StaticResource LabelStyle}"/>
                            <ComboBox Width="120" ItemsSource="{Binding ObjectNameCases}"
                                      SelectedItem="{Binding Global.VariableParamCase, Mode=TwoWay}"
                                      SelectionChanged="Setting_Changed">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumLocalizer}}"/></DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <TextBlock Text="{loc:Tr Key=GrpBracketSemicolon}" FontWeight="Bold" Margin="0,10,0,6"/>
                        <StackPanel Style="{StaticResource RowPanel}">
                            <TextBlock Text="{loc:Tr Key=LblSemicolon}" Style="{StaticResource LabelStyle}"/>
                            <ComboBox Width="120" ItemsSource="{Binding SemicolonModes}"
                                      SelectedItem="{Binding Global.SemicolonMode, Mode=TwoWay}"
                                      SelectionChanged="Setting_Changed">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumLocalizer}}"/></DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <CheckBox Content="{loc:Tr Key=ChkParenSameLine}" IsChecked="{Binding Global.ParenthesisOpenOnSameLine, Mode=TwoWay}"
                                  Style="{StaticResource CheckRow}" Click="Setting_Changed"/>
                        <CheckBox Content="{loc:Tr Key=ChkShortExpr}" IsChecked="{Binding Global.ShortExpressionSingleLine, Mode=TwoWay}"
                                  Style="{StaticResource CheckRow}" Click="Setting_Changed"/>
                        <CheckBox Content="{loc:Tr Key=ChkSingleQuote}" IsChecked="{Binding Global.SingleQuoteStandardize, Mode=TwoWay}"
                                  Style="{StaticResource CheckRow}" Click="Setting_Changed"/>

                        <!-- DML 语句（其余项） -->
                        <TextBlock Text="{loc:Tr Key=TabDml}" Style="{StaticResource SubHeader}"/>
                        <TextBlock Text="{loc:Tr Key=GrpSelect}" FontWeight="Bold" Margin="0,0,0,6"/>
                        <StackPanel Style="{StaticResource RowPanel}">
                            <TextBlock Text="{loc:Tr Key=LblAsKeyword}" Style="{StaticResource LabelStyle}"/>
                            <ComboBox Width="120" ItemsSource="{Binding AsKeywordModes}"
                                      SelectedItem="{Binding Dml.AsKeywordMode, Mode=TwoWay}"
                                      SelectionChanged="Setting_Changed">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumLocalizer}}"/></DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <CheckBox Content="{loc:Tr Key=ChkAlignColAlias}" IsChecked="{Binding Dml.AlignColumnAlias, Mode=TwoWay}"
                                  Style="{StaticResource CheckRow}" Click="Setting_Changed"/>
                        <CheckBox Content="{loc:Tr Key=ChkWrapFunc}" IsChecked="{Binding Dml.WrapLongFunction, Mode=TwoWay}"
                                  Style="{StaticResource CheckRow}" Click="Setting_Changed"/>
                        <CheckBox Content="{loc:Tr Key=ChkAlignColComment}" IsChecked="{Binding Dml.AlignColumnComments, Mode=TwoWay}"
                                  Style="{StaticResource CheckRow}" Click="Setting_Changed"/>
                        <TextBlock Text="{loc:Tr Key=GrpFromJoin}" FontWeight="Bold" Margin="0,10,0,6"/>
                        <CheckBox Content="{loc:Tr Key=ChkIndentJoin}" IsChecked="{Binding Dml.IndentJoinTable, Mode=TwoWay}"
                                  Style="{StaticResource CheckRow}" Click="Setting_Changed"/>
                        <CheckBox Content="{loc:Tr Key=ChkLogicBefore}" IsChecked="{Binding Dml.LogicOperatorBefore, Mode=TwoWay}"
                                  Style="{StaticResource CheckRow}" Click="Setting_Changed"/>
                        <CheckBox Content="{loc:Tr Key=ChkImplicitJoin}" IsChecked="{Binding Dml.ConvertImplicitJoin, Mode=TwoWay}"
                                  Style="{StaticResource CheckRow}" Click="Setting_Changed"/>
                        <TextBlock Text="{loc:Tr Key=GrpWhere}" FontWeight="Bold" Margin="0,10,0,6"/>
                        <CheckBox Content="{loc:Tr Key=ChkWhereIndent}" IsChecked="{Binding Dml.WhereIndentAllConditions, Mode=TwoWay}"
                                  Style="{StaticResource CheckRow}" Click="Setting_Changed"/>
                        <CheckBox Content="{loc:Tr Key=ChkWrapIn}" IsChecked="{Binding Dml.WrapLongInList, Mode=TwoWay}"
                                  Style="{StaticResource CheckRow}" Click="Setting_Changed"/>
                        <CheckBox Content="{loc:Tr Key=ChkAlignCompare}" IsChecked="{Binding Dml.AlignCompareOperator, Mode=TwoWay}"
                                  Style="{StaticResource CheckRow}" Click="Setting_Changed"/>
                        <CheckBox Content="{loc:Tr Key=ChkNestedParen}" IsChecked="{Binding Dml.NestedParenthesisIndent, Mode=TwoWay}"
                                  Style="{StaticResource CheckRow}" Click="Setting_Changed"/>
                        <TextBlock Text="{loc:Tr Key=GrpGroupOrderBy}" FontWeight="Bold" Margin="0,10,0,6"/>
                        <CheckBox Content="{loc:Tr Key=ChkGroupByEach}" IsChecked="{Binding Dml.GroupByEachColumnNewLine, Mode=TwoWay}"
                                  Style="{StaticResource CheckRow}" Click="Setting_Changed"/>
                        <CheckBox Content="{loc:Tr Key=ChkHavingWhere}" IsChecked="{Binding Dml.HavingReuseWhereStyle, Mode=TwoWay}"
                                  Style="{StaticResource CheckRow}" Click="Setting_Changed"/>
                        <CheckBox Content="{loc:Tr Key=ChkOrderByAlign}" IsChecked="{Binding Dml.OrderBySortAlign, Mode=TwoWay}"
                                  Style="{StaticResource CheckRow}" Click="Setting_Changed"/>
                        <CheckBox Content="{loc:Tr Key=ChkWindowFunc}" IsChecked="{Binding Dml.WindowFunctionIndent, Mode=TwoWay}"
                                  Style="{StaticResource CheckRow}" Click="Setting_Changed"/>
                        <TextBlock Text="{loc:Tr Key=GrpIudm}" FontWeight="Bold" Margin="0,10,0,6"/>
                        <CheckBox Content="{loc:Tr Key=ChkInsertWrap}" IsChecked="{Binding Dml.InsertColumnsWrap, Mode=TwoWay}"
                                  Style="{StaticResource CheckRow}" Click="Setting_Changed"/>
                        <CheckBox Content="{loc:Tr Key=ChkValuesAlign}" IsChecked="{Binding Dml.ValuesRowAlign, Mode=TwoWay}"
                                  Style="{StaticResource CheckRow}" Click="Setting_Changed"/>
                        <CheckBox Content="{loc:Tr Key=ChkUpdateEqual}" IsChecked="{Binding Dml.UpdateSetAlignEqual, Mode=TwoWay}"
                                  Style="{StaticResource CheckRow}" Click="Setting_Changed"/>
                        <CheckBox Content="{loc:Tr Key=ChkMergeIndent}" IsChecked="{Binding Dml.MergeBranchIndent, Mode=TwoWay}"
                                  Style="{StaticResource CheckRow}" Click="Setting_Changed"/>
                        <CheckBox Content="{loc:Tr Key=ChkOutputWrap}" IsChecked="{Binding Dml.OutputClauseWrap, Mode=TwoWay}"
                                  Style="{StaticResource CheckRow}" Click="Setting_Changed"/>

                        <!-- CTE -->
                        <TextBlock Text="{loc:Tr Key=TabCte}" Style="{StaticResource SubHeader}"/>
                        <CheckBox Content="{loc:Tr Key=ChkCteSingle}" IsChecked="{Binding Cte.WithSingleLine, Mode=TwoWay}"
                                  Style="{StaticResource CheckRow}" Click="Setting_Changed"/>
                        <CheckBox Content="{loc:Tr Key=ChkCteComma}" IsChecked="{Binding Cte.CteCommaNewLine, Mode=TwoWay}"
                                  Style="{StaticResource CheckRow}" Click="Setting_Changed"/>
                        <CheckBox Content="{loc:Tr Key=ChkCteBlank}" IsChecked="{Binding Cte.CteBlankLineSplit, Mode=TwoWay}"
                                  Style="{StaticResource CheckRow}" Click="Setting_Changed"/>
                        <CheckBox Content="{loc:Tr Key=ChkCteRecur}" IsChecked="{Binding Cte.RecursiveCteUnionIndent, Mode=TwoWay}"
                                  Style="{StaticResource CheckRow}" Click="Setting_Changed"/>
                        <StackPanel Style="{StaticResource RowPanel}">
                            <TextBlock Text="{loc:Tr Key=LblCteIndent}" Style="{StaticResource LabelStyle}"/>
                            <TextBox Width="60" Text="{Binding Cte.CteQueryIndent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     TextChanged="Setting_Changed"/>
                        </StackPanel>

                        <!-- CASE WHEN -->
                        <TextBlock Text="{loc:Tr Key=TabCase}" Style="{StaticResource SubHeader}"/>
                        <CheckBox Content="{loc:Tr Key=ChkCaseWhenNew}" IsChecked="{Binding Case.CaseEachWhenNewLine, Mode=TwoWay}"
                                  Style="{StaticResource CheckRow}" Click="Setting_Changed"/>
                        <CheckBox Content="{loc:Tr Key=ChkThenAlign}" IsChecked="{Binding Case.ThenValueAlign, Mode=TwoWay}"
                                  Style="{StaticResource CheckRow}" Click="Setting_Changed"/>
                        <CheckBox Content="{loc:Tr Key=ChkElseNew}" IsChecked="{Binding Case.ElseNewLine, Mode=TwoWay}"
                                  Style="{StaticResource CheckRow}" Click="Setting_Changed"/>
                        <CheckBox Content="{loc:Tr Key=ChkEndAlign}" IsChecked="{Binding Case.EndAlignCase, Mode=TwoWay}"
                                  Style="{StaticResource CheckRow}" Click="Setting_Changed"/>
                        <CheckBox Content="{loc:Tr Key=ChkShortCase}" IsChecked="{Binding Case.ShortCaseSingleLine, Mode=TwoWay}"
                                  Style="{StaticResource CheckRow}" Click="Setting_Changed"/>
                        <StackPanel Style="{StaticResource RowPanel}">
                            <TextBlock Text="{loc:Tr Key=LblWhenIndent}" Style="{StaticResource LabelStyle}"/>
                            <TextBox Width="60" Text="{Binding Case.WhenConditionIndent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     TextChanged="Setting_Changed"/>
                        </StackPanel>

                        <!-- 流程控制 -->
                        <TextBlock Text="{loc:Tr Key=TabFlow}" Style="{StaticResource SubHeader}"/>
                        <CheckBox Content="{loc:Tr Key=ChkIfBegin}" IsChecked="{Binding Flow.IfBeginSameLine, Mode=TwoWay}"
                                  Style="{StaticResource CheckRow}" Click="Setting_Changed"/>
                        <CheckBox Content="{loc:Tr Key=ChkEndIf}" IsChecked="{Binding Flow.EndMatchIfIndent, Mode=TwoWay}"
                                  Style="{StaticResource CheckRow}" Click="Setting_Changed"/>
                        <CheckBox Content="{loc:Tr Key=ChkIfElseBlank}" IsChecked="{Binding Flow.IfElseBlankSplit, Mode=TwoWay}"
                                  Style="{StaticResource CheckRow}" Click="Setting_Changed"/>
                        <CheckBox Content="{loc:Tr Key=ChkTryCatch}" IsChecked="{Binding Flow.TryCatchIndentBlock, Mode=TwoWay}"
                                  Style="{StaticResource CheckRow}" Click="Setting_Changed"/>
                        <CheckBox Content="{loc:Tr Key=ChkDeclareEach}" IsChecked="{Binding Flow.DeclareVariableEachLine, Mode=TwoWay}"
                                  Style="{StaticResource CheckRow}" Click="Setting_Changed"/>
                        <CheckBox Content="{loc:Tr Key=ChkExecWrap}" IsChecked="{Binding Flow.ExecParamWrap, Mode=TwoWay}"
                                  Style="{StaticResource CheckRow}" Click="Setting_Changed"/>

                        <!-- DDL -->
                        <TextBlock Text="{loc:Tr Key=TabDdl}" Style="{StaticResource SubHeader}"/>
                        <CheckBox Content="{loc:Tr Key=ChkCreateTable}" IsChecked="{Binding Ddl.CreateTableColumnWrap, Mode=TwoWay}"
                                  Style="{StaticResource CheckRow}" Click="Setting_Changed"/>
                        <CheckBox Content="{loc:Tr Key=ChkConstraint}" IsChecked="{Binding Ddl.ConstraintAlign, Mode=TwoWay}"
                                  Style="{StaticResource CheckRow}" Click="Setting_Changed"/>
                        <CheckBox Content="{loc:Tr Key=ChkProcParam}" IsChecked="{Binding Ddl.ProcParamWrap, Mode=TwoWay}"
                                  Style="{StaticResource CheckRow}" Click="Setting_Changed"/>
                        <CheckBox Content="{loc:Tr Key=ChkFuncReturn}" IsChecked="{Binding Ddl.FunctionReturnFormat, Mode=TwoWay}"
                                  Style="{StaticResource CheckRow}" Click="Setting_Changed"/>
                        <CheckBox Content="{loc:Tr Key=ChkTrigger}" IsChecked="{Binding Ddl.TriggerInsertedIndent, Mode=TwoWay}"
                                  Style="{StaticResource CheckRow}" Click="Setting_Changed"/>

                        <!-- 表达式 -->
                        <TextBlock Text="{loc:Tr Key=TabExpression}" Style="{StaticResource SubHeader}"/>
                        <CheckBox Content="{loc:Tr Key=ChkOpSpace}" IsChecked="{Binding Expression.OperatorSpacePad, Mode=TwoWay}"
                                  Style="{StaticResource CheckRow}" Click="Setting_Changed"/>
                        <CheckBox Content="{loc:Tr Key=ChkInExists}" IsChecked="{Binding Expression.InExistsWrap, Mode=TwoWay}"
                                  Style="{StaticResource CheckRow}" Click="Setting_Changed"/>
                        <CheckBox Content="{loc:Tr Key=ChkSingleComment}" IsChecked="{Binding Expression.SingleCommentIndent, Mode=TwoWay}"
                                  Style="{StaticResource CheckRow}" Click="Setting_Changed"/>
                        <CheckBox Content="{loc:Tr Key=ChkBlockComment}" IsChecked="{Binding Expression.BlockCommentFormat, Mode=TwoWay}"
                                  Style="{StaticResource CheckRow}" Click="Setting_Changed"/>
                        <StackPanel Style="{StaticResource RowPanel}">
                            <TextBlock Text="{loc:Tr Key=LblSubQueryIndent}" Style="{StaticResource LabelStyle}"/>
                            <TextBox Width="60" Text="{Binding Expression.SubQueryIndent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     TextChanged="Setting_Changed"/>
                        </StackPanel>

                        <!-- 特殊 T-SQL -->
                        <TextBlock Text="{loc:Tr Key=TabSpecial}" Style="{StaticResource SubHeader}"/>
                        <CheckBox Content="{loc:Tr Key=ChkAddDbo}" IsChecked="{Binding Tsql.AutoAddDboSchema, Mode=TwoWay}"
                                  Style="{StaticResource CheckRow}" Click="Setting_Changed"/>
                        <CheckBox Content="{loc:Tr Key=ChkRemoveDbo}" IsChecked="{Binding Tsql.AutoRemoveDboSchema, Mode=TwoWay}"
                                  Style="{StaticResource CheckRow}" Click="Setting_Changed"/>
                        <CheckBox Content="{loc:Tr Key=ChkTempTable}" IsChecked="{Binding Tsql.TempTableFormat, Mode=TwoWay}"
                                  Style="{StaticResource CheckRow}" Click="Setting_Changed"/>
                        <CheckBox Content="{loc:Tr Key=ChkTableVar}" IsChecked="{Binding Tsql.TableVariableFormat, Mode=TwoWay}"
                                  Style="{StaticResource CheckRow}" Click="Setting_Changed"/>
                        <CheckBox Content="{loc:Tr Key=ChkGlobalVar}" IsChecked="{Binding Tsql.GlobalVariableFormat, Mode=TwoWay}"
                                  Style="{StaticResource CheckRow}" Click="Setting_Changed"/>

                    </StackPanel>
                </Expander>

            </StackPanel>
        </ScrollViewer>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- 行3：SQL 预览 -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="2" Margin="4,4,4,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#E8E8E8" Padding="6,3">
                <TextBlock Text="{loc:Tr Key=PreviewTitle}" FontWeight="SemiBold"/>
            </Border>
            <TextBox Grid.Row="1"
                     Text="{Binding PreviewSql, Mode=OneWay}"
                     IsReadOnly="True"
                     FontFamily="Consolas, Courier New"
                     FontSize="12"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     Background="#FAFAFA"
                     BorderBrush="#CCCCCC"
                     BorderThickness="1"
                     Padding="6"
                     AcceptsReturn="True"
                     TextWrapping="NoWrap"/>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- 行4：底部按钮 -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="3" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0" Padding="8,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <CheckBox Grid.Column="0"
                          Content="{loc:Tr Key=ChkFormatOnSave}"
                          ToolTip="{loc:Tr Key=ChkFormatOnSaveTip}"
                          IsChecked="{Binding FormatOnSave, Mode=TwoWay}"
                          VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{loc:Tr Key=BtnOk}" Width="80" Margin="0,0,8,0" IsDefault="True" Click="OkButton_Click"/>
                    <Button Content="{loc:Tr Key=BtnCancel}" Width="80" Margin="0,0,8,0" IsCancel="True" Click="CancelButton_Click"/>
                    <Button Content="{loc:Tr Key=BtnApply}" Width="80" Click="ApplyButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
